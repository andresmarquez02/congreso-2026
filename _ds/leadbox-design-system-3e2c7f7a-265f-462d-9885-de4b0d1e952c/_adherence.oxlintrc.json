{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/shell/**",
              "ui_kits/leadbox_os/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|icon|badge|children|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: name, label, icon, badge, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initials, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|loading|disabled|as|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, size, loading, disabled, as, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|plain)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|critical|success|danger)$/]",
        "message": "<Button> tone must be one of 'default' | 'critical' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|md|lg|icon)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'md' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|id|name|disabled|indeterminate|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, id, name, disabled, indeterminate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|confirmText|cancelText|confirmColor|iconType|onConfirm|onCancel|children|style|key|ref|className|style|children)$/]",
        "message": "<ConfirmModal> doesn't accept that prop. Declared props: open, title, description, confirmText, cancelText, confirmColor, iconType, onConfirm, onCancel, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute[name.name='confirmColor'] > Literal[value!=/^(?:primary|red|blue|green|yellow|indigo)$/]",
        "message": "<ConfirmModal> confirmColor must be one of 'primary' | 'red' | 'blue' | 'green' | 'yellow' | 'indigo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute[name.name='iconType'] > Literal[value!=/^(?:warning|info|success|question)$/]",
        "message": "<ConfirmModal> iconType must be one of 'warning' | 'info' | 'success' | 'question'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|sortable|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, sortable."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|width|onClose|children|style|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, title, description, width, onClose, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyDataCardAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|icon|primary|key|ref|className|style|children)$/]",
        "message": "<EmptyDataCardAction> doesn't accept that prop. Declared props: label, onClick, icon, primary."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|mini)$/]",
        "message": "<Icon> variant must be one of 'outline' | 'solid' | 'mini'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|name|id|type|placeholder|error|helper|icon|disabled|success|clearable|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, name, id, type, placeholder, error, helper, icon, disabled, success, clearable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|number|password|search|tel|date|textArea)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'number' | 'password' | 'search' | 'tel' | 'date' | 'textArea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|message|onDismiss|children|style|key|ref|className|style|children)$/]",
        "message": "<Notification> doesn't accept that prop. Declared props: type, title, message, onDismiss, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:success|error|warning|info)$/]",
        "message": "<Notification> type must be one of 'success' | 'error' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|page|perPage|perPageOptions|onPageChange|onPerPageChange|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: total, page, perPage, perPageOptions, onPageChange, onPerPageChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|primaryColor|secondaryColor|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size, primaryColor, secondaryColor, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBreakdownRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|color|key|ref|className|style|children)$/]",
        "message": "<StatBreakdownRow> doesn't accept that prop. Declared props: label, count, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|key|ref|className|style|children)$/]",
        "message": "<SubTab> doesn't accept that prop. Declared props: key, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|underlinePosition|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, underlinePosition, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute[name.name='underlinePosition'] > Literal[value!=/^(?:bottom|top)$/]",
        "message": "<Tabs> underlinePosition must be one of 'bottom' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|variant|children|style|key|ref|className|style|children)$/]",
        "message": "<TagBadge> doesn't accept that prop. Declared props: type, variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagBadge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary|dark|gray|light|warning|danger|success|info|orange|dark_red)$/]",
        "message": "<TagBadge> type must be one of 'primary' | 'secondary' | 'dark' | 'gray' | 'light' | 'warning' | 'danger' | 'success' | 'info' | 'orange' | 'dark_red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TagBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fill|outline|duotone)$/]",
        "message": "<TagBadge> variant must be one of 'fill' | 'outline' | 'duotone'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<ToggleSwitch> doesn't accept that prop. Declared props: checked, onChange, disabled, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|placement|children|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: text, placement, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom|left|right)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Topbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:searchPlaceholder|locationLabel|userName|onSearchClick|style|key|ref|className|style|children)$/]",
        "message": "<Topbar> doesn't accept that prop. Declared props: searchPlaceholder, locationLabel, userName, onSearchClick, style."
      }
    ]
